@model WebCar.Models.ViewModels.CreateOrderViewModel

@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Đặt hàng
                    </h4>
                </div>

                <div class="card-body">
                    @using (Html.BeginForm("Create", "Order", FormMethod.Post, new { @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Thông tin xe -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                                {
                                    <img src="@Url.Content("~/images/" + Model.HinhAnh. Replace("images/", ""))"
                                         alt="@Model.TenXe"
                                         class="img-fluid rounded" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/default-car.jpg")"
                                         alt="No image"
                                         class="img-fluid rounded" />
                                }
                            </div>
                            <div class="col-md-8">
                                <h5>@Model.TenXe</h5>
                                <p class="text-muted">@Model.HangXe</p>
                                <h4 class="text-danger">
                                    @Model.Gia.ToString("N0") VNĐ
                                </h4>
                            </div>
                        </div>

                        @Html.HiddenFor(m => m.MaXe)
                        @Html.HiddenFor(m => m.TenXe)
                        @Html.HiddenFor(m => m.HangXe)
                        @Html.HiddenFor(m => m.Gia)
                        @Html.HiddenFor(m => m.HinhAnh)

                        <!-- Số lượng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-hashtag me-1"></i>
                                Số lượng
                            </label>
                            @Html.TextBoxFor(m => m.SoLuong, new { @class = "form-control", type = "number", min = "1", max = "10" })
                            @Html.ValidationMessageFor(m => m.SoLuong, "", new { @class = "text-danger" })
                        </div>

                        <!-- Địa chỉ giao hàng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                Địa chỉ giao hàng
                            </label>
                            @Html.TextAreaFor(m => m.DiaChiGiaoHang, new { @class = "form-control", rows = "2", placeholder = "Nhập địa chỉ nhận hàng" })
                            @Html.ValidationMessageFor(m => m.DiaChiGiaoHang, "", new { @class = "text-danger" })
                            <small class="text-muted">
                                <i class="fas fa-lock me-1"></i>
                                Thông tin này sẽ được mã hóa RSA
                            </small>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-phone me-1"></i>
                                Số điện thoại <span class="text-danger">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.SoDienThoai, new
                            {
                                @class = "form-control",
                                type = "tel",
                                placeholder = "0971224228 hoặc +84971224228",
                                pattern = "[0-9+]{10,13}",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Định dạng: 10-11 số, bắt đầu bằng 0 hoặc +84
                            </small>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-comment me-1"></i>
                                Ghi chú (tùy chọn)
                            </label>
                            @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = "3", placeholder = "Ghi chú về đơn hàng..." })
                        </div>

                        <!-- Tổng tiền -->
                        <div class="alert alert-info">
                            <h5 class="mb-0">
                                <i class="fas fa-calculator me-2"></i>
                                Tổng tiền:
                                <strong class="text-danger float-end" id="totalAmount">
                                    @Model.TongTien.ToString("N0") VNĐ
                                </strong>
                            </h5>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check me-2"></i>
                                Xác nhận đặt hàng
                            </button>
                            <a href="@Url.Action("Index", "Product")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>
                                Quay lại
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Calculate total when quantity changes
            $('#SoLuong').on('input', function () {
                var quantity = parseInt($(this).val()) || 1;
                var price = @Model.Gia;
                var total = quantity * price;

                $('#totalAmount').text(total.toLocaleString('vi-VN') + ' VNĐ');
            });
        });
    </script>
}