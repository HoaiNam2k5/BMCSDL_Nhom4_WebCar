@model WebCar.Models.ViewModels.OrderDetailViewModel

<div class="container mt-5 pt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fas fa-file-invoice me-2"></i>
                Chi tiết đơn hàng #@Model.MaDon
            </h4>
        </div>

        <div class="card-body">
            <!-- Order Info -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Thông tin đơn hàng</h5>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Mã đơn: </strong></td>
                            <td>#@Model.MaDon</td>
                        </tr>
                        <tr>
                            <td><strong>Ngày đặt:</strong></td>
                            <td>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td><strong>Trạng thái:</strong></td>
                            <td><span class="@Model.TrangThaiClass">@Model.TrangThai</span></td>
                        </tr>
                        <tr>
                            <td><strong>Tổng tiền:</strong></td>
                            <td class="text-danger fw-bold">@Model.TongTien.ToString("N0") VNĐ</td>
                        </tr>
                    </table>
                </div>

                <div class="col-md-6">
                    <h5>Thông tin khách hàng</h5>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Họ tên:</strong></td>
                            <td>@Model.HoTen</td>
                        </tr>
                        <tr>
                            <td><strong>Email:</strong></td>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <td><strong>SĐT:</strong></td>
                            <td>@Model.SDT</td>
                        </tr>
                        <tr>
                            <td><strong>Địa chỉ: </strong></td>
                            <td>@Model.DiaChi</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ✅ Car Info - Handle Missing Car -->
            @if (Model.MaXe > 0)
            {
                <h5>Thông tin xe</h5>
                <div class="row mb-4">
                    <div class="col-md-3">
                        @{
                            string imagePath = "~/images/" + (Model.HinhAnh ?? "default-car.jpg").Replace("images/", "");
                        }
                        <img src="@Url.Content(imagePath)"
                             alt="@Model.TenXe"
                             class="img-fluid rounded"
                             onerror="this.src='@Url.Content("~/images/default-car.jpg")'" />
                    </div>
                    <div class="col-md-9">
                        <h5>@Model.TenXe</h5>
                        <p class="text-muted">@Model.HangXe</p>
                        <p><strong>Số lượng:</strong> @Model.SoLuong</p>
                        <p><strong>Đơn giá: </strong> @Model.DonGia.ToString("N0") VNĐ</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Thông tin xe không khả dụng cho đơn hàng này
                </div>
            }

            <!-- Shipping Info -->
            @if (!string.IsNullOrEmpty(Model.DiaChiGiaoHang) || !string.IsNullOrEmpty(Model.SoDienThoai))
            {
                <h5>Thông tin giao hàng</h5>
                <div class="alert alert-info">
                    @if (!string.IsNullOrEmpty(Model.DiaChiGiaoHang))
                    {
                        <p><i class="fas fa-map-marker-alt me-2"></i><strong>Địa chỉ:</strong> @Model.DiaChiGiaoHang</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.SoDienThoai))
                    {
                        <p><i class="fas fa-phone me-2"></i><strong>SĐT:</strong> @Model.SoDienThoai</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <p><i class="fas fa-comment me-2"></i><strong>Ghi chú:</strong>@Model.GhiChu</p>
                    }
                </div>
            }

            <!-- Actions -->
            <div class="mt-4">
                <a href="@Url.Action("MyOrders")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i> Quay lại
                </a>

                @if (Model.TrangThai == "Cho xu ly")
                {
                    using (Html.BeginForm("Cancel", "Order", new { id = Model.MaDon }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này? ')">
                            <i class="fas fa-times-circle me-2"></i> Hủy đơn hàng
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>